   "source": [
    "from matplotlib import pyplot as plt\n",
    "import numpy as np\n",
    "data1=np.random.randint(1,100,size=100)\n",
    "dat2=np.random.randint(1,100,size=100)\n",
    "data=[data1,dat2]\n",
    "a=['1','2']\n",
    "plt.boxplot(data,label=a)#数据、标签"
