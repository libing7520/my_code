   "source": [
    "from matplotlib import pyplot as plt\n",
    "import numpy as np\n",
    "data=[10,20,30,40]\n",
    "explode=[0.1,0.1,0.1,0.1]\n",
    "plt.pie(data,#数据\n",
    "labels=['A','B','C','D'],#图例\n",
    "explode=explode,#分离\n",
    "autopct='%1.1f%%')#显示百分比\n",
    "plt.title('饼图示例')\n",
    "plt.show()\n"
   ],
